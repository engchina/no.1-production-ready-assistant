    "timeout_seconds": 120,
    "max_retries": 3
  },
  "generative_ai": {
    "embedding_model": "cohere.embed-v4.0",
    "embedding_dim": 1536,
    "rerank_model": "cohere.rerank-v4.0-fast"
  }
