{
  "name": "production-ready-nl2sql-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 3101",
    "build": "tsc --noEmit && vite build",
    "start": "vite preview --host 0.0.0.0 --port 3101",
    "test": "npm run test:startup && npm run test:logic",
    "test:startup": "bash ../scripts/tests/start-frontend.test.sh && bash ../scripts/tests/init-script-nodejs.test.sh",
    "test:logic": "tsc -p tsconfig.test.json && node --test scripts/run-unit-tests.test.mjs && node scripts/run-unit-tests.mjs",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --deny-warnings"
  },
  "dependencies": {
    "@fontsource-variable/noto-sans-hk": "5.3.1",
    "@fontsource-variable/noto-sans-jp": "5.3.1",
    "@fontsource-variable/noto-sans-sc": "5.3.1",
    "@fontsource-variable/noto-sans-tc": "5.3.1",
    "@fontsource/google-sans-code": "5.3.2",
    "@fontsource/roboto": "5.3.0",
    "@production-ready/system-settings": "file:../../platform/packages/system-settings",
    "@production-ready/ui": "file:../../platform/packages/ui",
    "@tanstack/react-query": "^5.62.0",
    "@xyflow/react": "^12.12.0",
    "lucide-react": "^0.468.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-router-dom": "^7.17.0",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jiti": "2.7.0",
    "oxlint": "1.89.0",
    "postcss": "8.5.32",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.2",
    "vite": "^8.0.16"
  },
  "overrides": {
    "postcss": "8.5.32"
  }
}
