{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  // 既定の correctness カテゴリ（oxlint 標準）に加え、src/** にデザインシステム遵守ルールを掛ける。
  // ルールと JS プラグインの正本は platform の docs/design-system/adherence.oxlintrc.json / design-system-plugin.mjs。
  // コピーせず相対パスで参照する（platform AGENTS.md「lint」節）。monorepo の platform/ を CI でも同じパスで参照する。
  // アプリ固有のルールを足す場合は、adherence のセレクタを上書きしないよう別のルール名にする。
  "extends": ["../../platform/docs/design-system/adherence.oxlintrc.json"],
  // アプリ固有のルール用に、同じプラグインを別名で読み込む（adherence の design-system/restricted-syntax を上書きしない）。
  // jsPlugins は extends 先とマージされないため、adherence のプラグイン（design-system）も並べて指定する。
  // アプリ固有のルールは、同じ実装を別名で再公開した lint/app-design-system-plugin.mjs で掛ける（adherence の設定を上書きしない）。
  "jsPlugins": [
    "../../platform/docs/design-system/design-system-plugin.mjs",
    "./lint/app-design-system-plugin.mjs",
    // react-hooks 7（React Compiler 系の set-state-in-effect / refs / purity 等を含む）を JS プラグインとして読み込む（#181）。
    // oxlint では react-hooks が組み込みプラグイン名として予約されているため、別名で読み込む。
    { "name": "react-hooks-compiler", "specifier": "eslint-plugin-react-hooks" }
  ],
  "overrides": [
    {
      "files": ["src/**/*.ts", "src/**/*.tsx"],
      "rules": {
        // eslint-plugin-react-hooks の configs.recommended.rules と同じルール・同じレベル（RAG #167 / Agent #179 と同じ）。
        "react-hooks-compiler/rules-of-hooks": "error",
        // #181 の段階 1〜3 で違反をすべて直し、recommended の全ルールを有効にした（exhaustive-deps は recommended と同じ warn。--deny-warnings で失敗扱いになる）。
        "react-hooks-compiler/exhaustive-deps": "warn",
        "react-hooks-compiler/static-components": "error",
        "react-hooks-compiler/use-memo": "error",
        "react-hooks-compiler/preserve-manual-memoization": "error",
        "react-hooks-compiler/incompatible-library": "warn",
        "react-hooks-compiler/immutability": "error",
        "react-hooks-compiler/globals": "error",
        "react-hooks-compiler/refs": "error",
        "react-hooks-compiler/set-state-in-effect": "error",
        "react-hooks-compiler/error-boundaries": "error",
        "react-hooks-compiler/purity": "error",
        "react-hooks-compiler/set-state-in-render": "error",
        "react-hooks-compiler/unsupported-syntax": "warn",
        "react-hooks-compiler/config": "error",
        "react-hooks-compiler/gating": "error"
        // 手書きの <table> の禁止（#530）は、3 製品で同じ規則として platform の adherence へ移した（#800）。
      }
    }
  ],
  // tests/** は computed style の実測値（rgb / px）や fixture を検証するため、adherence の対象外（files: src/**）。
  "ignorePatterns": ["dist/**", "playwright-report/**", "test-results/**"]
}
