# Production Ready NL2SQL configuration catalog（製品固有の設定）
# Copy only deployment-specific values to .env. Keep every secret, ID and DSN empty here.
# 3製品共通の設定（データベース接続・モデル・アップロード保存先・構成管理者・認証ポリシー）は
# platform の共通 .env（platform/.env、雛形 platform/.env.example）に PLATFORM_* で置く（#211）。
# ここには NL2SQL_* だけを置く。backend は共通 .env → この .env の順に読み、環境変数が最優先。

# Application
NL2SQL_APP_VERSION=0.1.0
NL2SQL_LOG_LEVEL=INFO
NL2SQL_SERVICE_NAME=production-ready-nl2sql
NL2SQL_CORS_ORIGINS=["http://localhost:3101","http://127.0.0.1:5173","http://127.0.0.1:3101"]
NL2SQL_ENABLE_METRICS=true
# PLATFORM_AUTH_MODE=local is permitted only with PLATFORM_ENVIRONMENT=local and grants the local SYSTEM_ADMIN identity.
NL2SQL_MAX_UPLOAD_BYTES=209715200

# Authentication / RBAC（構成管理者と認証ポリシーは platform/.env の PLATFORM_ADMIN_* / PLATFORM_AUTH_*）
# ログインの Cookie は 3 製品で共有する（名前は platform/.env の PLATFORM_AUTH_*_COOKIE_NAME。#1565）。

# NL2SQL runtime and persistence
NL2SQL_ALLOW_SELECT_ONLY=true
NL2SQL_DEFAULT_ROW_LIMIT=100
NL2SQL_JOB_MAX_CONCURRENCY=4
NL2SQL_JOB_WORKER_MODE=inprocess
NL2SQL_JOB_WORKER_POLL_SECONDS=1
NL2SQL_JOB_LEASE_SECONDS=900
NL2SQL_JOB_STALE_AFTER_SECONDS=1800
# oracle: Oracle を呼ぶ（既定）。deterministic は CI / テスト用の決定論スタブ（#897）。
NL2SQL_RUNTIME_MODE=oracle
NL2SQL_PERSISTENCE_MODE=oracle
NL2SQL_CACHE_TTL_SECONDS=5
NL2SQL_PROFILE_CACHE_MAX_ENTRIES=1000
NL2SQL_SCHEMA_OBJECT_CACHE_MAX_ENTRIES=500
NL2SQL_SCHEMA_REFRESH_WORKER_ENABLED=true
NL2SQL_SCHEMA_REFRESH_WORKER_MODE=inprocess
NL2SQL_QUALITY_EVALUATION_WORKER_MODE=inprocess
NL2SQL_QUALITY_EVALUATION_WORKER_POLL_SECONDS=1
NL2SQL_QUALITY_EVALUATION_LEASE_SECONDS=900
NL2SQL_QUALITY_EVALUATION_MAX_FILE_BYTES=10485760
NL2SQL_QUALITY_EVALUATION_MAX_CASES=100
NL2SQL_QUALITY_EVALUATION_MAX_ATTEMPTS=1000
NL2SQL_QUALITY_EVALUATION_ATTEMPT_TIMEOUT_SECONDS=300
# SQL生成評価の試行を同時に実行する数の上限（#2059。既定 2、1〜8）。SQL の生成と判定の呼び出しは 1 つの実行器を共有し、
# 429 を受けたら全体で待って並行の数を下げる。結果はケース・engine・繰り返しの位置に書く。1 は 1 件ずつ。
NL2SQL_QUALITY_EVALUATION_CONCURRENCY=2
NL2SQL_SCHEMA_REFRESH_LEASE_SECONDS=900
NL2SQL_ORACLE_CONNECT_TIMEOUT_SECONDS=5
NL2SQL_ORACLE_CALL_TIMEOUT_SECONDS=120
# 状態の保存先（ジョブ・履歴・業務プロファイル・オントロジー）の接続 pool の上限（#830）
NL2SQL_ORACLE_STATE_POOL_MAX=8
# 業務データの SELECT の実行（アプリの接続）の接続 pool の上限（#904）。
# system_admin 用と非 system_admin 用の 2 つの pool に、それぞれこの上限を使う
NL2SQL_ORACLE_RUNTIME_POOL_MAX=8
NL2SQL_SYSTEM_SCHEMA_DDL_LOCK_TIMEOUT_SECONDS=30
NL2SQL_CSV_IMPORT_MAX_ROWS=5000
NL2SQL_CSV_IMPORT_TEXT_MIN_CHARS=255
NL2SQL_CSV_IMPORT_TEXT_GROWTH_FACTOR=2.0
# 件数未指定の SELECT 実行で読み込む行数の安全上限（超えた分は読まず、結果を truncated にする）
NL2SQL_MAX_RESULT_ROWS=100000
# チャットで生成した SQL の実行の上限（#1154）: 1 回に取得する行数・セルの文字数・応答の行のバイト数。
# 超えた分は返さず、画面は打ち切ったことを出す（全件は SQL 生成・SELECT SQL の実行の画面で実行する）
NL2SQL_CHAT_RESULT_MAX_ROWS=1000
NL2SQL_CHAT_RESULT_MAX_CELL_CHARS=2000
NL2SQL_CHAT_RESULT_MAX_BYTES=2000000
# チャットのジョブの中で実行した結果の行を、画面が受け取るまで置いておく上限（秒。#1176。受け取ったら消す）
NL2SQL_CHAT_RESULT_RETENTION_SECONDS=600
# 操作が途絶えた未完了の query session（回答前の確認など）を中止するまでの時間（秒。既定 24 時間）
NL2SQL_QUERY_SESSION_IDLE_TTL_SECONDS=86400
# 回答前の確認で、全部の質問に答えた後に要件のまとめを LLM で検査し直す回数の上限（#1439。既定 2、1〜10。
# 確認のカードの往復の上限はこの値 + 1 で、既定は 3 回）
NL2SQL_REQUIREMENT_MAX_REVIEW_ROUNDS=2
# 回答前の確認の LLM の呼び出し（#1715）。利用者が画面で待つので、共通の LLM の設定より短く待ち、
# 再試行を少なくする。出力の上限は 16384（#2310。8192 以上）で、ほかの呼び出しと違い 32768 へ
# 引き上げずにそのまま送る（モデルの出力の上限（システム設定 › モデル）では抑える）。止まらない出力を
# 早く切り、上限を広げずに推論の量を下げて 1 回だけ送り直す。
# 待ち時間は 240 秒（#2240。応答まで 9.6〜208 秒とぶれる実測。再試行 1 回で最悪 480 秒）。
NL2SQL_REQUIREMENT_TIMEOUT_SECONDS=240
NL2SQL_REQUIREMENT_MAX_RETRIES=1
NL2SQL_REQUIREMENT_MAX_OUTPUT_TOKENS=16384
# SELECT 実行で使ってよい利用者定義・package 関数（カンマ区切り。例: APP.FMT_CODE,UTIL_PKG.LABEL）。
# 未登録の関数は表スコープ判定を経ずにデータを読めるため拒否する
NL2SQL_ALLOWED_USER_FUNCTIONS=
NL2SQL_CSV_IMPORT_MAX_COLUMNS=200

# Ontology
NL2SQL_ONTOLOGY_GRAPH_CACHE_MAX_REVISIONS=3
NL2SQL_ONTOLOGY_GRAPH_CACHE_MAX_MEGABYTES=256
NL2SQL_ONTOLOGY_WORKER_MODE=inprocess
# AI 構築の抽出/命名呼び出しが要る出力トークンの量（モデルの出力の上限で抑える。#1719）
NL2SQL_ONTOLOGY_EXTRACTION_MAX_OUTPUT_TOKENS=32768
# GraphRAG 流 gleaning(取りこぼし回収の追加パス)。0 で無効
NL2SQL_ONTOLOGY_EXTRACTION_GLEANING_PASSES=1
# 1 回の抽出呼び出しに載せる資料本文の上限文字数
NL2SQL_ONTOLOGY_EXTRACTION_BATCH_MAX_CHARS=12000
# 一括の LLM・Embedding の呼び出しの並行の上限（#2004）。429 を受けたら全体で待って並行の数を下げ（最小 1）、成功が続けば上限まで戻す。
# 結果は入力の順のまま。1 は 1 件ずつ。AI 構築の抽出と PDF の OCR（既定 4）、コメント・アノテーションの SQL の生成（既定 4）、Embedding（既定 2）
NL2SQL_ONTOLOGY_BUILD_CONCURRENCY=4
NL2SQL_METADATA_SQL_CONCURRENCY=4
NL2SQL_EMBEDDING_CONCURRENCY=2
# 公開前の Markdown 解析の実行期限（秒）。待機時間を含み、自動再送しない
NL2SQL_ONTOLOGY_PREPARATION_TIMEOUT_SECONDS=600
NL2SQL_ONTOLOGY_WORKER_POLL_SECONDS=1
# 旧公開推論ジョブの絶対期限（秒）
NL2SQL_ONTOLOGY_PUBLISH_TIMEOUT_SECONDS=600
# 旧実データ検証ジョブの絶対期限（秒）
NL2SQL_ONTOLOGY_VALIDATION_TIMEOUT_SECONDS=600
NL2SQL_ONTOLOGY_WORKER_CLAIM_TIMEOUT_SECONDS=3900
# 構築全体の期限（6時間）と実行 heartbeat の失効時間（2分）
NL2SQL_ONTOLOGY_BUILD_TIMEOUT_SECONDS=21600
NL2SQL_ONTOLOGY_BUILD_LEASE_SECONDS=120
NL2SQL_ONTOLOGY_REASONING_PROFILE=owl2rl
NL2SQL_ONTOLOGY_SHACL_ENABLED=true
NL2SQL_ONTOLOGY_PROFILE_CONFIRMATION_REQUIRED=true
NL2SQL_ONTOLOGY_CONFIRMATION_TTL_SECONDS=900

# SQL の生成 / schema catalog
NL2SQL_ENTERPRISE_AI_DIRECT_ENABLED=true
NL2SQL_SCHEMA_OWNER_ALLOWLIST=[]
NL2SQL_SCHEMA_SAMPLE_ROWS=3
NL2SQL_SCHEMA_SAMPLE_COLUMNS_PER_TABLE=6

# Feedback embedding
NL2SQL_FEEDBACK_EMBEDDING_ENABLED=false
NL2SQL_FEEDBACK_VECTOR_TABLE=NL2SQL_FEEDBACK_VECTORS
NL2SQL_FEEDBACK_VECTOR_INDEX=NL2SQL_FEEDBACK_VEC_IDX
