# No.1 Production Ready Suite — 3製品共通の設定（#211）
#
# このファイルを `platform/.env` にコピーして使う。RAG / NL2SQL / Agent の backend は
# 共通 `.env`（このファイル）→ 製品の `backend/.env` の順に読む（環境変数が最優先）。
# 場所は `PLATFORM_ENV_FILE` で上書きできる（コンテナなど）。
# システム設定画面（OCI 認証・アップロード保存先・モデル・データベース）で保存した値もここへ書かれる。
# 変数名はすべて `PLATFORM_` で始める。製品固有の設定は製品の `backend/.env` に置く。
# secret・OCID・DSN はここでは空にしておく。

# 実行環境と認証方式（3 製品共通）。local でだけ免ログインを明示できる。
PLATFORM_ENVIRONMENT=staging
PLATFORM_AUTH_MODE=authenticated

# 時間帯（3 製品で共通。#3255・#3274）。IANA の地域名（既定 UTC。日本時間にするなら Asia/Tokyo = 東京・大阪の時刻。
# +09:00 のような固定の offset は使えない）。今日（検索・期間の基準日）と既定の時間帯に使う。配備では Terraform の timezone から書き、
# platform/deploy/suite-init.sh が Compute の OS の時間帯をこの値に合わせる。時刻の保存は UTC のまま
# （DB の session の時間帯は '+00:00' に固定する）。
PLATFORM_TIMEZONE=UTC

# 構成管理者（共通認証。login ID は system_admin 固定）
PLATFORM_ADMIN_LOGIN_USER_ID=system_admin
PLATFORM_ADMIN_LOGIN_USER_PASSWORD=

# 認証ポリシー（共通認証。認証方式は PLATFORM_AUTH_MODE）
PLATFORM_AUTH_COOKIE_SECURE=true
# ログインの Cookie の名前（3 製品で共有する。1 回のログインで全製品を使える。#1565）。
# frontend の CSRF の Cookie 名（@production-ready/system-settings の CSRF_COOKIE_NAME）と同じにする。
PLATFORM_AUTH_SESSION_COOKIE_NAME=pr_session
PLATFORM_AUTH_CSRF_COOKIE_NAME=pr_csrf
PLATFORM_AUTH_IDLE_TIMEOUT_MINUTES=60
PLATFORM_AUTH_ABSOLUTE_TIMEOUT_HOURS=12
PLATFORM_AUTH_FAILED_LOGIN_LIMIT=5
PLATFORM_AUTH_LOCKOUT_MINUTES=15
# ログインの試行の回数の制限（構成管理者を含む全ユーザー。#1087）。窓（分）の中の失敗が、
# ログイン ID と送信元 IP の組ごとに LOGIN_ATTEMPT_LIMIT 回、送信元 IP ごとに LOGIN_IP_ATTEMPT_LIMIT 回に
# 達したら、窓が過ぎるまで 429 を返す。0 でその単位の制限を無効にする。失敗の記録は共通のテーブル
# PLATFORM_LOGIN_ATTEMPTS に置き、3 製品・全 worker で共有して数える（#1173。DB が使えないときはプロセス内）。
PLATFORM_AUTH_LOGIN_ATTEMPT_LIMIT=5
PLATFORM_AUTH_LOGIN_IP_ATTEMPT_LIMIT=20
PLATFORM_AUTH_LOGIN_ATTEMPT_WINDOW_MINUTES=15
PLATFORM_AUTH_PASSWORD_MIN_LENGTH=12
PLATFORM_AUTH_PASSWORD_MAX_LENGTH=128
PLATFORM_AUTH_ARGON2_TIME_COST=3
PLATFORM_AUTH_ARGON2_MEMORY_KIB=65536
PLATFORM_AUTH_ARGON2_PARALLELISM=4

# サービス間の token の署名鍵（Agent が RAG / NL2SQL の MCP を Run の利用者として呼ぶ。#230）
# 32 文字以上のランダムな値（例: `openssl rand -base64 48`）。空なら MCP は 503 を返す。
# ログインの試行の記録（PLATFORM_LOGIN_ATTEMPTS）の HMAC の鍵もここから導く（#1173。空なら DB に記録しない）。
PLATFORM_SERVICE_TOKEN_SECRET=

# 公開の基底の URL（例: https://203.0.113.10 / https://203.0.113.10:8443。末尾の / は付けない）。
# OCI の配備では platform/deploy/suite-init.sh が公開 IP（無ければ private IP）と公開の port から書く。
# API キーの画面の接続先に「公開の URL」として出す（空なら今開いている画面の URL だけ。#1870）。
PLATFORM_PUBLIC_BASE_URL=

# 外部の MCP クライアントの API キーの上限（#1874。乱用・誤用の防止。0 は上限なし）
# 1 分あたりの呼び出しの回数（キーごと。3 製品の POST /api/mcp。超えたら 429 と Retry-After）。
# backend のプロセス（worker）ごとに数える。
PLATFORM_API_KEY_CALLS_PER_MINUTE=60
# 直近 24 時間に Agent の MCP で作れる Run（業務 Agent への質問・確認への答え）の数（キーごと）。
PLATFORM_API_KEY_RUNS_PER_DAY=200

# Oracle AI Database（3製品で同じ schema を使う）
PLATFORM_ORACLE_USER=
PLATFORM_ORACLE_PASSWORD=
PLATFORM_ORACLE_DSN=
PLATFORM_ORACLE_DRIVER_MODE=thin
PLATFORM_ORACLE_CONNECTION_SECURITY=wallet_mtls
# 空なら python-oracledb Thin mode（Wallet は PLATFORM_ORACLE_WALLET_DIR）。Instant Client を使う Thick mode は
# 配置先（例: /u01/aipoc/instantclient_23_26）を指定する。
PLATFORM_ORACLE_CLIENT_LIB_DIR=
PLATFORM_ORACLE_WALLET_DIR=/u01/aipoc/wallet
# 空欄の場合、OCI Wallet 自動取得では PLATFORM_ORACLE_PASSWORD を Wallet password として使用し、
# PLATFORM_ORACLE_WALLET_PASSWORD にも同じ値を保存する。
PLATFORM_ORACLE_WALLET_PASSWORD=
PLATFORM_ORACLE_DB_TEST_TIMEOUT_SECONDS=15
PLATFORM_ORACLE_TCP_CONNECT_TIMEOUT_SECONDS=10
PLATFORM_ORACLE_ADB_OCID=
PLATFORM_ORACLE_ADB_REGION=

# OCI 認証
PLATFORM_OCI_REGION=
PLATFORM_OCI_COMPARTMENT_ID=
PLATFORM_OCI_CONFIG_FILE=~/.oci/config
PLATFORM_OCI_CONFIG_PROFILE=DEFAULT
# NL2SQL の OCI 認証方式（config_file 以外を使う場合の API キー情報）
PLATFORM_OCI_AUTH_MODE=config_file
PLATFORM_OCI_USER_OCID=
PLATFORM_OCI_FINGERPRINT=
PLATFORM_OCI_TENANCY_OCID=
PLATFORM_OCI_KEY_FILE=

# モデル
# 秘密でない値は画面から PLATFORM_MODEL_SETTINGS_FILE（相対パスはこのファイルの場所から）へ保存する。
# API key は PLATFORM_OCI_ENTERPRISE_AI_API_KEY（プライマリ接続）・
# PLATFORM_OCI_ENTERPRISE_AI_SECONDARY_API_KEY（セカンダリ接続）・
# PLATFORM_OCI_ENTERPRISE_AI_TERTIARY_API_KEY（ターシャリ接続）だけに置く。
PLATFORM_MODEL_SETTINGS_FILE=model-settings.json
# OCI Enterprise AI のプライマリ接続（既定）。
# Endpoint URL は入力どおり使い、{Endpoint URL}/responses を呼ぶ（path は補わない。#1440）。
# OCI Enterprise AI は /openai/v1 まで書く。
# 例: https://inference.generativeai.us-chicago-1.oci.oraclecloud.com/openai/v1
PLATFORM_OCI_ENTERPRISE_AI_ENDPOINT=
PLATFORM_OCI_ENTERPRISE_AI_PROJECT_OCID=
PLATFORM_OCI_ENTERPRISE_AI_API_KEY=
# OCI Enterprise AI のセカンダリ接続（任意。#533）。Endpoint URL を入れるとセカンダリ接続が有効になり、
# 登録モデルの "connection_id": "secondary" で使う（未指定のモデルはプライマリ接続）。
# 設定するときは Endpoint URL・Project OCID・API key をすべて入れる（#542）。
PLATFORM_OCI_ENTERPRISE_AI_SECONDARY_ENDPOINT=
PLATFORM_OCI_ENTERPRISE_AI_SECONDARY_PROJECT_OCID=
PLATFORM_OCI_ENTERPRISE_AI_SECONDARY_API_KEY=
# ターシャリ接続（任意。#786）。OpenAI / OpenAI 互換 API 向け（OCI Enterprise AI にも使える）。
# Endpoint URL を入れるとターシャリ接続が有効になり、登録モデルの "connection_id": "tertiary" で使う。
# 設定するときは Endpoint URL と API key を入れる。Project OCID は OCI Enterprise AI に使うときだけ入れる
# （入れたときだけ OpenAI-Project ヘッダーを送る）。呼び出しは Responses API（{Endpoint URL}/responses）。
# Endpoint URL は API の base URL まで書く（例: https://api.openai.com/v1・https://api.deepseek.com/v1）。
PLATFORM_OCI_ENTERPRISE_AI_TERTIARY_ENDPOINT=
PLATFORM_OCI_ENTERPRISE_AI_TERTIARY_PROJECT_OCID=
PLATFORM_OCI_ENTERPRISE_AI_TERTIARY_API_KEY=
# 例: [{"model_id":"m","display_name":"M","vision_enabled":true,"connection_id":"primary"}]
PLATFORM_OCI_ENTERPRISE_AI_MODELS=[]
# 既定のテキストモデルと既定の Vision モデル（#499）。登録モデルがあれば 2 つとも必須（#566）。
# テキストが空の既存環境は、実行時は既定の Vision モデルを使う（安全策）。モデル設定で選んで保存する。
# 画面で保存した値（model-settings.json）がこれより優先される。
PLATFORM_OCI_ENTERPRISE_AI_DEFAULT_TEXT_MODEL=
PLATFORM_OCI_ENTERPRISE_AI_DEFAULT_VISION_MODEL=
# 品質評価で回答を判定するモデル（#3574）。空 = 既定のテキストモデル、same_as_answer = 回答を作ったモデル、
# それ以外は登録モデルの ID。画面で保存した値（model-settings.json）がこれより優先される。
PLATFORM_OCI_ENTERPRISE_AI_DEFAULT_JUDGE_MODEL=
PLATFORM_OCI_ENTERPRISE_AI_LLM_PATH=/responses
PLATFORM_OCI_ENTERPRISE_AI_LLM_PAYLOAD_TEMPLATE=
PLATFORM_OCI_ENTERPRISE_AI_LLM_RESPONSE_PATH=
PLATFORM_OCI_ENTERPRISE_AI_VLM_PATH=/responses
PLATFORM_OCI_ENTERPRISE_AI_VLM_PAYLOAD_TEMPLATE=
PLATFORM_OCI_ENTERPRISE_AI_VLM_RESPONSE_PATH=
PLATFORM_OCI_ENTERPRISE_AI_VLM_INPUT_MODE=auto
PLATFORM_OCI_ENTERPRISE_AI_TIMEOUT_SECONDS=600
PLATFORM_OCI_ENTERPRISE_AI_MAX_RETRIES=3
# 出力の上限（tokens）は登録モデルごとに、システム設定 › モデル の表の「出力の上限」で決める（#1719。既定 32768、
# 入力の上限以下）。共通の LLM / VLM の出力の上限の変数は無い。
# チャットで同じ会話の前のターンを LLM に渡す予算（3 製品で共通。#1818）。新しいターンから順に、ターン数と
# 合計の文字数に入るだけ渡し、古いターンを落とす。1 ターンが上限を超えたら長い部分（回答・SQL）を切り詰める。
# ターン数 0〜50（0 で履歴を渡さない）、1 ターン 200〜32000 文字、合計 1000〜200000 文字。
PLATFORM_CHAT_HISTORY_MAX_TURNS=8
PLATFORM_CHAT_HISTORY_MAX_CHARS_PER_TURN=4000
PLATFORM_CHAT_HISTORY_MAX_CHARS=16000
# チャットの「会話の履歴」（4 つのチャットの左の一覧）に出す期間（3 製品で共通。#2340）。最後の更新が直近 N 日の
# 会話だけを一覧に出す（表示の絞り込みで、会話は消さない。期間の外の会話も実行の詳細の「会話を開く」・直接の
# リンクからは開ける）。0〜3650 日（0 で期間で絞らない）。
PLATFORM_CHAT_HISTORY_DAYS=90
# チャットの添付ファイル（会話の期間だけ使う作業ファイル。3 製品で共通。#2517）。Oracle AI Database の
# PLATFORM_CHAT_ATTACHMENTS に保存し、最後に添付・送信に使ってから TTL（時間）を過ぎたら消す。
# TTL 1〜720 時間、1 つの大きさ 1048576〜104857600 bytes（1〜100 MiB）、1 つの会話の件数 1〜50。
PLATFORM_CHAT_ATTACHMENT_TTL_HOURS=24
PLATFORM_CHAT_ATTACHMENT_MAX_BYTES=20971520
PLATFORM_CHAT_ATTACHMENT_MAX_FILES=10
# OCI Generative AI（埋め込み / リランクのみ）
PLATFORM_OCI_GENAI_EMBEDDING_MODEL=cohere.embed-v4.0
PLATFORM_OCI_GENAI_EMBEDDING_DIM=1536
PLATFORM_OCI_GENAI_RERANK_MODEL=cohere.rerank-v4.0-fast
# NL2SQL の埋め込み / リランク呼び出し先（空なら region から決める）
PLATFORM_OCI_GENAI_ENDPOINT=
PLATFORM_OCI_GENAI_EMBED_MODEL_ID=cohere.embed-v4.0
PLATFORM_OCI_GENAI_RERANK_MODEL_ID=cohere.rerank-v4.0-fast

# アップロード保存先
PLATFORM_UPLOAD_STORAGE_BACKEND=local
PLATFORM_LOCAL_STORAGE_DIR=/u01/data/production-ready
PLATFORM_OBJECT_STORAGE_REGION=
PLATFORM_OBJECT_STORAGE_NAMESPACE=
PLATFORM_OBJECT_STORAGE_BUCKET=production-ready

# 共通 trace。exporter の変更は各 API / worker の再起動で反映する。本文・SQL・引数・結果は送らない。
PLATFORM_TRACE_ENABLED=true
PLATFORM_TRACE_SAMPLE_RATE=1.0
# OTLP/HTTP の traces の完全な URL（空なら外部へ送らない）。
PLATFORM_TRACE_OTLP_ENDPOINT=
PLATFORM_TRACE_OTLP_API_KEY=
PLATFORM_TRACE_QUEUE_SIZE=2048
PLATFORM_TRACE_BATCH_SIZE=256
PLATFORM_TRACE_EXPORT_TIMEOUT_SECONDS=5
PLATFORM_TRACE_SHUTDOWN_TIMEOUT_SECONDS=10
PLATFORM_TRACE_UI_MAX_SEGMENTS=16
PLATFORM_TRACE_UI_MAX_SPANS=1000
# 共通の span の表（PLATFORM_TRACE_SPANS。処理の経過の記録。#3226）の保存期限（日）。0 は無期限（既定。自動で消さない）。
# 量の目安: 1 回答 20〜50 span・1 日 1,000 回答で 1 日 約 20〜50 MB、1 年で 約 8〜18 GB。多いときは日数で短くできる。
PLATFORM_TRACE_RETENTION_DAYS=0
# span の表へまとめて書く間隔（秒）・件数と、書く前に溜める上限（満杯なら境界の span 以外の開始の知らせを捨てる）。
PLATFORM_TRACE_STORE_FLUSH_SECONDS=0.5
PLATFORM_TRACE_STORE_BATCH_SIZE=100
PLATFORM_TRACE_STORE_QUEUE_SIZE=5000
