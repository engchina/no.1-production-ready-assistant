            "default": null,
            "description": "段を開いて見る詳細（見出しと値・行・SQL や JSON。上限で切り、秘密を伏せる）。"
          },
          "name": {
            "anyOf": [
              {
                "maxLength": 128,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "span の名前（段が span のとき。#3226）。",
            "title": "Name"
          },
          "parent_id": {
            "anyOf": [
              {
                "maxLength": 200,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "親の span の id（入れ子を作る）。",
            "title": "Parent Id"
          },
          "root": {
            "anyOf": [
