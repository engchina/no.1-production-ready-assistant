                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "実行の全体の span。",
            "title": "Root"
          },
          "trace_id": {
            "anyOf": [
              {
                "pattern": "^[0-9a-f]{32}$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "span の trace id。",
            "title": "Trace Id"
          },
          "attributes": {
            "anyOf": [
              {
                "additionalProperties": {
                  "$ref": "#/$defs/ChatProgressParamValue"
