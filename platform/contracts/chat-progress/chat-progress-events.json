            "default": null,
            "title": "Finished At"
          },
          "detail": {
            "anyOf": [
              {
                "maxLength": 200,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "短い補足（件数・回数など）。",
            "title": "Detail"
          },
          "params": {
            "anyOf": [
              {
                "additionalProperties": {
                  "$ref": "#/$defs/ChatProgressParamValue"
                },
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "画面が名前・補足を組み立てる値（ツール名・件数など）。",
            "title": "Params"
          },
          "details": {
            "anyOf": [
              {
                "$ref": "#/$defs/ChatProgressStepDetails"
              },
              {
                "type": "null"
