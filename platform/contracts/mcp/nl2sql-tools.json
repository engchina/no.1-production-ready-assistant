    {
      "name": "nl2sql_recommend_profile",
      "title": "業務プロファイルの推薦",
      "description": "質問に合う業務プロファイルを推薦します。推薦できないときは null で、candidates に score の高い順の候補（説明・表の名前と質問の語が重なるもの）を返します。profile_ids を渡すと、その中からだけ推薦します。同じ会話の続きの質問では前のターンと同じ業務プロファイルを使い、推薦し直すのは話題が変わったときだけです。",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "question": {
            "description": "利用者の質問（日本語。指示語・省略は前の質問で補い、それだけで意味の通る文にする）",
            "maxLength": 4000,
            "minLength": 1,
            "title": "Question",
            "type": "string"
          },
          "profile_ids": {
            "anyOf": [
              {
                "items": {
                  "type": "string"
                },
                "maxItems": 50,
                "minItems": 1,
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "推薦の候補にする業務プロファイルの ID（省略時は使えるすべて）",
            "title": "Profile Ids"
          }
        },
        "required": [
          "question"
        ],
        "title": "RecommendProfileInput",
        "type": "object"
      },
      "annotations": {
        "readOnlyHint": true
      },
      "outputSchema": {
        "$defs": {
          "RecommendationCandidate": {
            "properties": {
              "id": {
                "title": "Id",
                "type": "string"
              },
              "name": {
                "title": "Name",
                "type": "string"
              },
              "reason": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "title": "Reason"
              },
              "score": {
                "anyOf": [
                  {
                    "type": "number"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "title": "Score"
              }
            },
            "required": [
              "id",
              "name"
            ],
            "title": "RecommendationCandidate",
            "type": "object"
          }
