        "properties": {
          "schema_version": {
            "default": 2,
            "description": "出力の形の版（変わったら上がる）。",
            "title": "Schema Version",
            "type": "integer"
          },
          "recommended_profile_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
