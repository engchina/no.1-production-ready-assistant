{
  "name": "@production-ready/ui",
  "version": "0.4.0",
  "description": "Shared design tokens, primitives, layout shell and state views for the No.1 Production Ready product family (RAG / NL2SQL / Agent).",
  "license": "MIT",
  "private": true,
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/engchina/no.1-production-ready-suite.git",
    "directory": "platform/packages/ui"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "vite"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./tokens.css": "./dist/tokens.css",
    "./styles.css": "./dist/tokens.css",
    "./vite/third-party-licenses": {
      "types": "./vite/third-party-licenses.d.mts",
      "default": "./vite/third-party-licenses.mjs"
    }
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json && node ./scripts/copy-css.mjs",
    "dev": "vite build --watch",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "lucide-react": ">=0.460.0",
    "react": ">=19.0.0",
    "react-dom": ">=19.0.0",
    "zustand": ">=5.0.0"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "tailwind-merge": "^2.6.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "happy-dom": "^20.14.6",
    "lucide-react": "^0.468.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "typescript": "^5.7.2",
    "vite": "^8.3.4",
    "vitest": "^4.1.12",
    "zustand": "^5.0.15"
  }
}
