{
  "version": 1,
  "issue": "#75",
  "description": "文脈補足と複数の検索表現の比較の合成の評価セット。架空の社内文書（sources/*.md）で、業務の内容を含まない。evidence の quote は根拠の child chunk の本文に含まれる文字列。 妨害の資料として既存の合成の評価セット（multi-hop・business-support）の HTML を同じ索引に入れ、multi-hop の質問の一部を取り込む（新しい版に置き換わった文書は索引に入れない）。",
  "groups": {
    "lost_subject_title": "主語・適用対象が文書名・章の見出しにしか無い断片（同じ構造の別の文書がある）",
    "lost_subject_deep": "主語が同じ節の前の段落にしか無く、見出し・文書名・親の冒頭でも分からない断片",
    "paraphrase": "質問と本文の語が違う言い換え",
    "direct_match": "コード・様式の番号の直接の一致",
    "self_contained": "本文が主語を持つ自己完結した断片",
    "long_evidence": "長い根拠の中ほどにある答え",
    "unanswerable": "資料に答えの無い質問",
    "multi_hop_existing": "既存の multi-hop の評価セットの質問（1 段・節の読み取り・比較・文書の中の参照。根拠のどれか 1 つが上位に入れば命中）"
  },
  "distractor_sources": [
    "multi-hop/sources",
    "business-support/sources"
  ],
  "imported_cases": {
    "path": "multi-hop/multi-hop.json",
    "group": "multi_hop_existing",
    "reasoning_types": [
      "single_hop",
      "section_read",
      "comparison",
      "intra_document_reference"
    ]
  },
