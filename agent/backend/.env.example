# Production Ready Agent — Agent 固有の設定（#211）
#
# このファイルを `agent/backend/.env` にコピーして使う。変数名はすべて `AGENT_` で始める。
# 3製品共通の設定（OCI 認証・アップロード保存先・モデル・データベース。`PLATFORM_*`）は
# monorepo の `platform/.env`（雛形は `platform/.env.example`）に置き、ここには書かない。
# backend は共通 `.env` → このファイルの順に読む（環境変数が最優先）。

# サービス共通の基本設定（pr_backend_core.BaseServiceSettings）
AGENT_APP_VERSION=0.1.0
AGENT_LOG_LEVEL=INFO
AGENT_CORS_ORIGINS=["http://localhost:3000"]

# 環境と認証方式は platform/.env の PLATFORM_ENVIRONMENT / PLATFORM_AUTH_MODE で指定する。
# ===== 認証（#215 / #750。RAG / NL2SQL と同じ共通認証）=====
# local: ログインを省略し、全権限のローカル利用者として使う（開発用）。
# authenticated: 共通認証のログインが必要。Cookie のないリクエストは 401。
# どちらもユーザー・ロールは Oracle の PLATFORM_* / AGENT_ROLE_*（共通 .env の PLATFORM_ORACLE_* が必要）。
# 構成管理者（PLATFORM_ADMIN_*）と認証ポリシー（PLATFORM_AUTH_*）は共通 .env（platform/.env）に置く。
# テーブルは 運用設定 > システムテーブル か `uv run python -m app.cli.agent_system_schema --initialize` で作る（PLATFORM_ORACLE_* で接続）。
# ログインの Cookie は 3 製品で共有する（名前は platform/.env の PLATFORM_AUTH_*_COOKIE_NAME。#1565）。

# Run・業務 Agent と、画面で変えた定義（Skill・MCP 接続・ツール権限・自動実行・評価）の保存先（#764）。
# auto（既定。#839）: 共通 .env の PLATFORM_ORACLE_* がそろっていれば oracle_checkpoint、無ければ memory。起動時に決まるので、
#   起動の後に DB を設定したら backend を再起動する。DB に接続できない（ADB の停止中など）あいだも backend は起動し、
#   業務の API は 503 を返す（画面は DB ゲートで案内する）。接続できるようになると、再起動せずに読み込む（#1212）。
# memory: 保存しない。backend の再起動（uvicorn --reload を含む）で消える。画面の先頭に案内が出る
# file: AGENT_RUNTIME_SNAPSHOT_PATH の JSON（開発・検証用）
# oracle_checkpoint / oracle_normalized: 共通 .env の PLATFORM_ORACLE_* の DB。テーブルはシステムテーブルが作る
# （oracle_normalized は監査用の projection も書く）。旧 AGENT_RUNTIME_ORACLE_* は読まない。DB に接続できないあいだは auto と同じ。
# 保存済みの Run の 1 件の不整合では起動を止めない（直せるものは直し、直せないものは元の JSON のまま退避する。#853）。
# 保存済みの checkpoint 全体が読めないときは、auto は保存しない状態にして画面で案内し、oracle_* / file は業務の API を
# 止める（直し方を返す）。
# 今の保存先は「運用設定 > 実行環境」の「保存先」で確認できる。
AGENT_RUNTIME_REPOSITORY_BACKEND=auto
# AGENT_RUNTIME_SNAPSHOT_PATH=.agent-runtime/snapshot.json
# oracle_normalized の監査用の projection（AGENT_RUNTIME_RUNS など）を残す日数。既定の 0 は無期限で、Run の記録を
# 自動では削除しない（#3235）。正の値にすると、保存のたびにその日数より古い行を消す。
# AGENT_RUNTIME_PROJECTION_RETENTION_DAYS=0

# 共通 .env の PLATFORM_ORACLE_* への接続 pool の大きさ（#793）。共通認証・システムテーブル・Run の保存が使う。
# AGENT_ORACLE_POOL_MIN_CONNECTIONS=1
# AGENT_ORACLE_POOL_MAX_CONNECTIONS=8

# ===== MCP 接続（RAG / NL2SQL / 外部 MCP。#233 / #757）=====
# MCP 接続 `rag` / `nl2sql` の初期値。各製品の `POST /api/mcp` を、Run を作った利用者（共通認証のユーザー）として呼ぶ。
# token は呼び出しごとに共通 .env の PLATFORM_SERVICE_TOKEN_SECRET で署名する（3製品で同じ値にする）。
# 画面の「MCP 接続」で変えた値は保存先（AGENT_RUNTIME_REPOSITORY_BACKEND）に残り、この値より優先する。
# AGENT_EXTERNAL_RAG_MCP_URL=http://rag-host/api/mcp
# 接続 `rag` の 1 回の呼び出しの待ち時間（秒。画面の「MCP 接続」の上限は 900）。`rag_search` は RAG の回答生成を通しで待つため、
# RAG の回答の上限（RAG_ANSWER_TIMEOUT_SECONDS、既定 600 秒）に、HTTP の往復と応答の組み立ての余裕 30 秒を足す（#1425 / #1430）。
AGENT_EXTERNAL_RAG_TIMEOUT_SECONDS=630
# 画面（ブラウザ）から RAG を開く起点。RAG の図の根拠を開く短命の URL（#1311）の path をこの起点に付ける。
# 空なら RAG が MCP の呼び出しを受けた起点（上の MCP の URL の host）のまま使う。
# AGENT_EXTERNAL_RAG_PUBLIC_URL=http://rag-host
# AGENT_EXTERNAL_NL2SQL_MCP_URL=http://nl2sql-host/api/mcp
# 接続 `nl2sql` の 1 回の呼び出しの待ち時間（秒）。NL2SQL の MCP は SQL の生成・実行をジョブにし、1 回の呼び出しでは
# ジョブの結果を最大 45 秒（wait_seconds）だけ待って、終わらなければ job_id を返す。nl2sql_query は
# SQL の生成前の確認（LLM。下書きと回答の後の再検査で最大 2 回。#1441）を呼び、その分だけジョブを待つ秒数を減らす。待ちの上限 45 秒と
# SQL の生成前の確認の 480 秒（NL2SQL の LLM 1 回 240 秒 × 試行 2 回。#2240）に、HTTP の往復・ジョブの登録・DB の負荷の余裕 75 秒を足して
# 600 秒にする（#1432・#2240。画面の「MCP 接続」の上限 900 秒以内）。続きの nl2sql_get_job は 1 回 20 秒まで待ち、ジョブの完了は下の
# AGENT_NL2SQL_JOB_WAIT_SECONDS まで続きを取って待つ（#848 / #1430）。
AGENT_EXTERNAL_NL2SQL_TIMEOUT_SECONDS=600
# NL2SQL のジョブが実行中のまま返ったとき、ツールの中で完了を待つ合計の上限（秒。0 は待たない。#848）
# AGENT_NL2SQL_JOB_WAIT_SECONDS=300
# 外部の MCP 接続の宣言（JSON。server_id・base_url・auth_mode・資格情報・timeout_seconds）。
# MCP の 1 メッセージの再試行の回数（#854）。接続できない・接続の timeout・429 / 503 は全ツール、502 / 504 は読み取り専用の
# ツールだけ再試行する（書き込みのツールは呼び先に届いた後の失敗では再送しない）。待ちは 0.5 秒から 2 倍ずつ（上限 8 秒・jitter、
# Retry-After に従う）で、1 回のツールの呼び出し全体は接続の timeout（*_TIMEOUT_SECONDS）に収める。
# AGENT_EXTERNAL_MCP_MAX_RETRIES=3
# AGENT_EXTERNAL_MCP_SERVERS_JSON=[{"server_id":"erp","base_url":"https://erp.example/mcp","auth_mode":"api_key","api_key":"..."}]

# ===== Run の実行 =====
# in_process: backend の中 / external: 別プロセスの runtime-dispatcher
# （`uv run python -m app.features.agent.runtime_dispatcher`。Oracle の保存先が必要）。
# AGENT_RUNTIME_DISPATCH_MODE=in_process
# モデルの応答が出力の上限で未完了（max_output_tokens）でも、使った出力が上限のこの割合未満なら、呼び先の一時的な不具合として
# 同じ要求を 1 回だけ送り直す（#2355。0 は送り直さない。送り直しも未完了なら推論の量を下げる送り直し・失敗の今までの扱い）。
# AGENT_MODEL_INCOMPLETE_RETRY_OUTPUT_RATIO=0.1
# モデルに渡す入力を、モデルの入力の上限に収める（#2383）。予算は登録モデルの入力の上限（システム設定 > モデル の max_input_tokens）から
# 出力の上限と余白（入力の上限 × 割合）を引いた token の数。超えるときは古いツールの結果から縮め（根拠の ID は残す）、それでも収まらなければ
# モデルを呼ばずに理由の分かる失敗にする。token の見積もりは platform の estimate_input_tokens（ASCII は 4 字で 1、ほかは 1 字で 1）× 係数。
# AGENT_CONTEXT_COMPACTION_ENABLED=true
# AGENT_CONTEXT_TOKEN_ESTIMATE_SCALE=1.0
# AGENT_CONTEXT_SAFETY_MARGIN_RATIO=0.05
# 支援タスクの予算（#1243）。超える呼び出しは実行せず、ツールの結果（budget_exceeded）でモデルに知らせる。0 以下は上限なし。
# Run ごとの RAG の呼び出し（rag_search・rag_retrieve_evidence。既定 6 は 5 段の多段の質問と 1 回の言い換え。#1345）と、
# 同じ会話の通しのツールの呼び出し。本文を読む rag_read_source・rag_outline・rag_read_document は Run ごとの上限に数えない。
# AGENT_MAX_RAG_CALLS_PER_RUN=6
# AGENT_MAX_TOOL_CALLS_PER_TASK=60
# 回答の最終の検証（#1246。#1277 で既定 true）。true のとき、RAG の根拠を使った回答を、保存する前に根拠を返した RAG の接続ごとに
# MCP rag_validate_answer で検証し、根拠で確かめられない段落は回答に載せず「資料で確認できず除いた内容」として示す
# （RAG がモデルを 1 回呼ぶため、接続ごとに 10〜20 秒増える）。検証が失敗したときは回答を残して「検証できませんでした」と示す。
# AGENT_FINAL_VALIDATION_ENABLED=true
# 根拠・データのツールを呼ばずに作った回答の拒答（#1835。既定 true）。true のとき、RAG・NL2SQL・登録した MCP 接続のツールを持つ
# 業務 Agent が、どれも呼ばずに最終の回答を作ったら 1 回だけモデルへ差し戻し、それでも呼ばなければ「社内の資料・業務データで
# 確かめられなかったため、お答えできません。」で始まる決まった文に置き換える（確認の質問だけの回答は除く）。
# AGENT_TOOL_GROUNDING_REQUIRED=true
# 品質評価の 1 ケースの上限時間（秒。Run の実行。判定は別。#1432）。0 は自動で、接続 `rag` の待ち時間（画面で保存した値。既定 630 秒）
# ×（AGENT_MAX_RAG_CALLS_PER_RUN + 1）にする（既定 630 ×（6 + 1）= 4410 秒。300〜86400 秒に収める）。RAG を使う業務 Agent の Run は
# RAG を予算の回数まで呼び、1 回は RAG の回答生成を通しで待つため（推論の量 medium で 1 Run 160〜600 秒以上）、固定の 300 秒では
# 時間切れになった。+1 は回答の最終の検証とモデルの推論の分。正の値を書くとその秒数（86400 秒まで）にする。
AGENT_EVALUATION_CASE_TIMEOUT_SECONDS=0
# 品質評価で同時に実行するケースの数の上限（#2004。既定 2、1〜8）。判定のモデルの呼び出しは job の中で共通の上限つきの並行の実行器を
# 共有し、429 を受けたら全体で待って並行の数を下げ（最小 1）、成功が続けばこの上限まで戻す。結果はケースの順のまま。1 は 1 件ずつ。
# AGENT_EVALUATION_CONCURRENCY=2
# 業務 Agent の版の履歴に残す版の数（#2356。既定 5、1〜100）。新しい版を公開したとき、公開日時の新しい順に超えた版を消す。
# 公開中の版は古くても残す（前の版に戻しているときは、公開中の版と直近の版で計この数）。版の番号は振り直さない。
# AGENT_MAX_PUBLISHED_VERSIONS=5
# 公開に求める品質評価の合格率（0〜1。0 は求めない。#2519）。0 より大きいと、下書きを最後に変えた後に
# 始めた下書きの評価（完了したもの）の最新の合格率がこの値以上でないと公開できない。
# AGENT_PUBLISH_MIN_PASS_RATE=0
# 公開前の回帰の門（0〜1。未設定は使わない。#2569）。公開中の版がある業務 Agent は、下書きの評価と同じ
# 評価セット・同じ評価ケースで公開中の版を評価した最新の評価を基準にし、下書きの合格率が「基準 − この値」
# 以上でないと公開できない（基準の評価が無ければ、公開中の版を評価するよう案内して断る）。例: 0.05。
# AGENT_PUBLISH_MAX_PASS_RATE_DROP=
# 公開前の評価の門で求める、下書きの評価のケースの数の下限（0 は求めない。#2569）。上の 2 つの門の
# どちらかを使うときだけ見る（ケースが少ないと 1 件で合格率が大きく動くため）。例: 20。
# AGENT_PUBLISH_MIN_CASES=0

# 記録済みの出力を本文に繰り返す報告の見出し（JSON の配列。空配列なら内部名の節だけを除く）。
# AGENT_OUTPUT_RECORD_SECTION_TITLES=["記録","記録内容","記録された項目","記録した項目","出力の記録","出力項目の記録"]
